---
import { HUBS, hubPath, type Lang } from '../data/catalog';
import { SITE, PATHS, t } from '../data/site';
interface Props { lang: Lang }
const { lang } = Astro.props;
const half = Math.ceil(HUBS.length / 2);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div>
      <div class="fname">{SITE.name}</div>
      <div style="color:oklch(65% .01 255);font-size:.85rem;margin-bottom:1rem">{SITE.tagline[lang]}</div>
      <p style="max-width:34ch">{t('serviceAreas', lang)}. {t('englishSpanish', lang)}.</p>
      <p style="font-size:.8rem;color:oklch(60% .01 255)">{t('principalOffice', lang)}. {SITE.attorneyFull}, {t('stateBar', lang)}.</p>
    </div>
    <div>
      <h4>{t('practiceAreas', lang)}</h4>
      <ul>{HUBS.slice(0, half).map((h) => <li><a href={hubPath(h, lang)}>{h.name[lang]}</a></li>)}</ul>
    </div>
    <div>
      <h4>&nbsp;</h4>
      <ul>{HUBS.slice(half).map((h) => <li><a href={hubPath(h, lang)}>{h.name[lang]}</a></li>)}
        <li><a href={PATHS.practiceAreas[lang]}>{t('allPracticeAreas', lang)} →</a></li>
      </ul>
    </div>
    <div>
      <h4>{t('contact', lang)}</h4>
      <ul>
        <li><a href={SITE.phoneHref}>{SITE.phone}</a></li>
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>{SITE.address.street}<br />{SITE.address.city}, {SITE.address.state} {SITE.address.zip}</li>
        <li>{SITE.hours[lang]}</li>
        <li style="margin-top:.5rem"><a href={PATHS.about[lang]}>{t('about', lang)}</a> · <a href={PATHS.contact[lang]}>{t('contact', lang)}</a></li>
      </ul>
    </div>
  </div>
  <div class="bottom">
    <div class="container">
      <span>© {year} {SITE.firm}. {t('allRights', lang)}</span>
      <span><a href={PATHS.privacy[lang]}>{t('privacy', lang)}</a></span>
    </div>
    <div class="container" style="display:block;margin-top:.6rem;max-width:var(--max)"><p style="margin:0 0 .5rem">{t('attorneyResponsible', lang)}</p><p style="margin:0 0 .5rem">{t('contingencyDisclosure', lang)}</p><p style="margin:0">{t('disclaimer', lang)}</p></div>
  </div>
</footer>
