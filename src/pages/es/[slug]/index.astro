---
import HubPage from '../../../templates/HubPage.astro';
import ServicePage from '../../../templates/ServicePage.astro';
import { allSlugs, resolveSlug } from '../../../lib/content';
export function getStaticPaths() {
  return allSlugs('es').map((slug) => ({ params: { slug } }));
}
const { slug } = Astro.params;
const r = resolveSlug(slug!, 'es')!;
---
{r.kind === 'hub' ? <HubPage lang="es" hub={r.hub} /> : <ServicePage lang="es" hub={r.hub} service={r.service} />}
