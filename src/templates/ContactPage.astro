---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import type { Lang } from '../data/catalog';
import { SITE, PATHS, t } from '../data/site';
import { CONTACT } from '../data/pages';
interface Props { lang: Lang }
const { lang } = Astro.props;
const alt: Lang = lang === 'en' ? 'es' : 'en';
const mapQ = encodeURIComponent(`${SITE.address.street}, ${SITE.address.city}, ${SITE.address.state} ${SITE.address.zip}`);
---
<Base lang={lang} title={CONTACT.title[lang]} description={CONTACT.metaDescription[lang]} path={PATHS.contact[lang]} altPath={PATHS.contact[alt]}>
  <section class="hero hero-inner on-dark">
    <div class="container">
      <div class="hero-copy">
        <nav class="crumbs" aria-label={t('breadcrumbAria', lang)}><ol><li><a href={PATHS.home[lang]}>{t('home', lang)}</a></li><li aria-current="page">{t('contact', lang)}</li></ol></nav>
        <div class="eyebrow gold">{CONTACT.eyebrow[lang]}</div>
        <h1>{CONTACT.h1[lang]}</h1>
        <p class="lede">{CONTACT.lede[lang]}</p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container contact-grid">
      <div class="contact-card">
        <h2 style="font-size:1.8rem">{t('freeConsultation', lang)}</h2>
        <ContactForm lang={lang} />
      </div>
      <div>
        <ul class="info-list">
          <li><b>{t('call', lang)}</b><a href={SITE.phoneHref} style="font-family:var(--font-serif);font-size:1.8rem">{SITE.phone}</a></li>
          <li><b>Email</b><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><b>{lang === 'en' ? 'Office' : 'Oficina'}</b>{SITE.address.street}<br />{SITE.address.city}, {SITE.address.state} {SITE.address.zip}</li>
          <li><b>{lang === 'en' ? 'Hours' : 'Horario'}</b>{SITE.hours[lang]}</li>
          <li><b>{lang === 'en' ? 'Languages' : 'Idiomas'}</b>{t('englishSpanish', lang)}</li>
        </ul>
        <iframe class="map" style="margin-top:1.5rem" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title={lang === 'en' ? 'Map to the Law Office of Robert Navar' : 'Mapa a Law Office of Robert Navar'} src={`https://www.google.com/maps?q=${mapQ}&output=embed`}></iframe>
      </div>
    </div>
  </section>
</Base>
