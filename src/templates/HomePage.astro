---
import Base from '../layouts/Base.astro';
import HubCard from '../components/HubCard.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import CtaMid from '../components/CtaMid.astro';
import { HUBS, type Lang } from '../data/catalog';
import { SITE, PATHS, t } from '../data/site';
import { HOME } from '../data/pages';
import { hubContent } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const alt: Lang = lang === 'en' ? 'es' : 'en';
const faqLd = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: HOME.faqs.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })),
};
---
<Base lang={lang} title={HOME.title[lang]} description={HOME.metaDescription[lang]} path={PATHS.home[lang]} altPath={PATHS.home[alt]} jsonLd={[faqLd]}>
  <section class="hero on-dark">
    <div class="container">
      <div class="hero-copy">
        <div class="eyebrow gold">{HOME.eyebrow[lang]}</div>
        <h1>{HOME.h1a[lang]} <span class="gold">{HOME.h1b[lang]}</span></h1>
        <p class="lede">{HOME.lede[lang]}</p>
        <div class="actions">
          <a class="btn btn-gold btn-lg" href={SITE.phoneHref}>📞 {t('callNow', lang)}</a>
          <a class="btn btn-outline btn-lg" href={PATHS.contact[lang]}>{t('getInTouch', lang)}</a>
        </div>
        <p class="fine">{t('stateBar', lang)} · {t('serving', lang)}</p>
        <blockquote class="quote">“{HOME.quote[lang]}”<cite>— {SITE.attorneyFull}</cite></blockquote>
      </div>
      <div class="hero-photo">
        <img src="/images/robert-navar-el-paso-attorney.webp" width="900" height="1200" alt={lang === 'en' ? 'Robert Navar, El Paso attorney, at his desk — Law Office of Robert Navar' : 'Robert Navar, abogado de El Paso, en su escritorio — Law Office of Robert Navar'} fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="stats">
    <div class="container">
      {HOME.stats.map((s) => <div class="stat"><b>{s.b}</b><span>{s.s[lang]}</span></div>)}
    </div>
  </section>

  <section class="section">
    <div class="narrow prose">
      <h2>{HOME.introHeading[lang]}</h2>
      <hr class="rule-gold" />
      {HOME.intro[lang].map((p) => <p>{p}</p>)}
    </div>
  </section>

  <section class="section bg-paper2" id="practice-areas">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">{t('whatWeHandle', lang)}</div>
        <h2>{t('practiceAreas', lang)}</h2>
        <p>{lang === 'en' ? 'Twelve practice areas, one office. Pick the one that matches your situation — every page tells you the fee, the timeline and whether you ever go to court.' : 'Doce áreas de práctica, una oficina. Elija la que corresponda a su situación — cada página le dice el honorario, el tiempo y si alguna vez va a corte.'}</p>
      </div>
      <div class="grid grid-3">
        {HUBS.map((h) => <HubCard lang={lang} hub={h} summary={hubContent(h.id).summary[lang]} />)}
      </div>
      <div style="margin-top:2rem"><CtaMid lang={lang} /></div>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">{HOME.whyEyebrow[lang]}</div>
        <h2>{HOME.whyHeading[lang]}</h2>
      </div>
      <div class="grid grid-3">
        {HOME.why.map((w) => <div class="feature"><h3>{w.h[lang]}</h3><p>{w.p[lang]}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">{HOME.processEyebrow[lang]}</div>
        <h2>{HOME.processHeading[lang]}</h2>
      </div>
      <div class="steps">
        {HOME.process.map((s, i) => <div class="step"><div class="num">0{i + 1}</div><div><h3>{s.t[lang]}</h3><p>{s.p[lang]}</p></div></div>)}
      </div>
    </div>
  </section>

  <section class="section bg-paper2">
    <div class="container local">
      <div>
        <div class="eyebrow">{HOME.localEyebrow[lang]}</div>
        <h2>{HOME.localHeading[lang]}</h2>
        {HOME.local[lang].map((p) => <p class="muted">{p}</p>)}
        <p><strong>{SITE.address.street}, {SITE.address.city}, {SITE.address.state} {SITE.address.zip}</strong></p>
        <div class="pills">{HOME.localPills.map((p) => <span>{p}</span>)}</div>
      </div>
      <img src="/images/franklin-mountains-el-paso.webp" width="1200" height="1500" loading="lazy" alt={lang === 'en' ? 'Franklin Mountains over El Paso, Texas — the Law Office of Robert Navar serves all of El Paso County' : 'Montañas Franklin sobre El Paso, Texas — Law Office of Robert Navar sirve a todo el Condado de El Paso'} />
    </div>
  </section>

  <Faq lang={lang} faqs={HOME.faqs} heading={lang === 'en' ? 'Common questions about the Law Office of Robert Navar' : 'Preguntas comunes sobre Law Office of Robert Navar'} />
  <CtaBand lang={lang} />
</Base>
